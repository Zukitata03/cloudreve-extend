# Office-LAN IPv4 address of the spare PC. Prefer a DHCP reservation.
LAN_IP=192.168.1.45

# Tailscale IPv4 address of the spare PC (`tailscale ip -4`).
TAILSCALE_IP=100.84.27.118

# Office line's public static IP (the A record target for cloud.acl0ud.xyz).
# Caddy returns 403 to visitors from any other address. Several IPs: space-separate.
OFFICE_PUBLIC_IP=CHANGE_ME_TO_YOUR_STATIC_IP

# Alibaba Cloud AccessKey for Caddy's DNS-01 certificate challenge.
# Create an AccessKey with ONLY "AliyunDNSFullAccess" permission at:
#   https://ram.console.aliyun.com/users
# (RAM console -> Users -> your user -> Permissions -> add AliyunDNSFullAccess)
# Then create the AccessKey there and paste the ID + Secret below.
# Do NOT use your main account AccessKey — use a RAM sub-account, least privilege.
ALIDNS_ACCESS_KEY_ID=
ALIDNS_ACCESS_KEY_SECRET=

# PostgreSQL password for both Cloudreve and Postgres.
# Generate your own: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public self-registration for Cloudreve. Disabled by default in code to
# prevent spam signups on the exposed instance. Set to 1 to re-enable the
# register API (then restart: docker compose up -d). NOTE: the signup UI was
# removed from the frontend repo; fully re-enabling also requires restoring
# those files from git history and rebuilding the frontend.
ALLOW_REGISTER=0
