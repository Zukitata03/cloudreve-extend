{
	# Use Alibaba Cloud DNS for the DNS-01 challenge so we can get a real
	# Let's Encrypt cert without exposing port 80 to the public internet.
	acme_dns alidns {
		access_key_id {$ALIDNS_ACCESS_KEY_ID}
		access_key_secret {$ALIDNS_ACCESS_KEY_SECRET}
	}
}

cloud.acl0ud.xyz {
	# Company-only: 403 for anyone not coming from the office public IP,
	# the LAN, or the Tailscale tailnet (CGNAT range).
	@outsiders not remote_ip {$OFFICE_PUBLIC_IP} 192.168.0.0/16 100.64.0.0/10
	respond @outsiders 403
	# Cloudreve is reached over the internal Docker network, so this traffic
	# never leaves the host and can stay plaintext on port 5212.
	reverse_proxy cloudreve:5212
}
